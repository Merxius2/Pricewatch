# Server
PRICEWATCH_HOST=0.0.0.0
PRICEWATCH_PORT=8080
PRICEWATCH_DATABASE_URL=sqlite:///./data/pricewatch.db

# Ollama (local LLM on mini-PC)
PRICEWATCH_OLLAMA_BASE_URL=http://localhost:11434
PRICEWATCH_OLLAMA_MODEL=llama3.2

# Good-search MCP (already running on the target host)
# See docs/good-search-setup.md
PRICEWATCH_GOOD_SEARCH_MCP_URL=http://127.0.0.1:8765/mcp
PRICEWATCH_GOOD_SEARCH_AUTO_DISCOVER=true
# PRICEWATCH_GOOD_SEARCH_MCP_URL_CANDIDATES=http://127.0.0.1:8765/mcp,http://127.0.0.1:8420/mcp
# Optional: set explicitly if auto-discovery picks the wrong tools
PRICEWATCH_GOOD_SEARCH_SEARCH_TOOL=
PRICEWATCH_GOOD_SEARCH_FETCH_TOOL=
PRICEWATCH_GOOD_SEARCH_TIMEOUT_SECONDS=120

# Scheduler
PRICEWATCH_CHECK_INTERVAL_MINUTES=60
